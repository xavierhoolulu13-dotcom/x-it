# ── Core ─────────────────────────────────────────────────────────────────────
# Public URL of the deployment (used by NextAuth for callbacks).
NEXTAUTH_URL="http://localhost:3000"
# 32+ byte secret. Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# Set to 1 to log NextAuth's internal debugging.
NEXTAUTH_DEBUG=""

# Where X-IT keeps its durable state (JSON store, workspaces, browser sessions).
X_IT_DATA_DIR="./.x-it-data"

# Hosts allowed to embed the app in an iframe (CSP frame-ancestors, space
# separated). Defaults to 'self' plus the Arena/E2B preview origins. Set this when
# hosting behind your own proxy, and leave it unset for a standalone deployment.
X_IT_FRAME_ANCESTORS=""

# ── AI providers (optional) ──────────────────────────────────────────────────
# OpenAI or any OpenAI-compatible endpoint. If unset, X-IT runs its offline
# demo agent (demo mode) which still executes real tools in the sandbox.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
DEFAULT_MODEL="gpt-4o-mini"

# Local models through Ollama.
OLLAMA_BASE_URL=""

# ── Browser automation ───────────────────────────────────────────────────────
# Path to a Chromium/Chrome binary. When unset, X-IT extracts the bundled
# @sparticuz/chromium build via scripts/prepare-chromium.mjs.
X_IT_CHROME_EXECUTABLE_PATH=""
# Directory with Chromium's shared libraries (only needed for bundled builds).
X_IT_CHROME_LIB_DIR=""
# Allow navigating to private/loopback addresses (needed to preview local
# servers through the browser tool). Off by default.
X_IT_ALLOW_PRIVATE_NETWORK=""
# Close idle browser sessions after this many milliseconds (default 30 min).
BROWSER_IDLE_SHUTDOWN_MS="1800000"

# ── Sandbox ──────────────────────────────────────────────────────────────────
# auto | docker | local — `auto` uses Docker when reachable, else the hardened
# local backend (path jail + command policy + detached processes).
SANDBOX_BACKEND="auto"
DOCKER_HOST="unix:///var/run/docker.sock"
SANDBOX_BASE_IMAGE="x-it-sandbox:latest"
SANDBOX_CPU_LIMIT="2"
SANDBOX_MEMORY_LIMIT="2048"
SANDBOX_PORT_RANGE_START="8080"
SANDBOX_PORT_RANGE_END="9080"

# ── Approvals ────────────────────────────────────────────────────────────────
# How long an approval request may wait before it expires.
APPROVAL_TIMEOUT_SECONDS="300"
# true = never ask for approval (automation/CI only).
X_IT_AUTO_APPROVE="false"

# ── Automation ───────────────────────────────────────────────────────────────
# Static bearer token for machine access to the API (CI, scripts, agents).
X_IT_API_TOKEN=""

# ── Demo account ─────────────────────────────────────────────────────────────
DEMO_EMAIL="demo@xit.dev"
DEMO_PASSWORD="demo1234"
# true = visiting / signs straight into the demo account (zero-click demos and
# hosted previews). Only ever authenticates the demo account above; leave false
# for a real deployment.
X_IT_DEMO_AUTOLOGIN="false"

# ── Optional OAuth ───────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
