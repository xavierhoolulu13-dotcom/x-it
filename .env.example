# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/xit"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-change-this-in-production"

# AI Providers
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL="https://api.openai.com/v1"
DEFAULT_MODEL="gpt-4"

# Docker Sandbox
DOCKER_HOST="unix:///var/run/docker.sock"
SANDBOX_BASE_IMAGE="x-it-sandbox:latest"
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=2048
SANDBOX_DISK_LIMIT=10240
SANDBOX_PORT_RANGE_START=8080
SANDBOX_PORT_RANGE_END=9080

# App
APP_URL="http://localhost:3000"
ENCRYPTION_KEY="your-encryption-key-change-this"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Optional: OAuth
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""